{
  "name": "@relativistic-ui/gravity-vue",
  "type": "module",
  "version": "1.1.0",
  "private": false,
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/types/index.ts",
      "default": "./src/index.ts"
    },
    "./composables": {
      "types": "./src/composables/index.ts",
      "default": "./src/composables/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/types/index.ts",
  "files": [
    "README.md",
    "src"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist .turbo",
    "clean:all": "rm -rf dist .turbo node_modules",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.16.2",
    "@relativistic-ui/gravity-core": "*",
    "@relativistic-ui/typescript-config": "*",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.30.1",
    "happy-dom": "^18.0.1",
    "typescript": "latest",
    "vitest": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
