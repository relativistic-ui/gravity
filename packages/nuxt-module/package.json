{
  "name": "@relativistic-ui/gravity-nuxt",
  "version": "1.1.0",
  "description": "Gravity Nuxt module",
  "repository": "your-org/my-module",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": {
      "types": "./src/types/index.ts",
      "default": "./src/module.ts"
    }
  },
  "main": "./src/module.ts",
  "types": "./src/types/index.ts",
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit",
    "deploy:patch": "yarn publish --access public",
    "deploy:minor": "yarn publish --access public",
    "deploy:major": "yarn publish --access public",
    "clean": "rm -rf dist .turbo",
    "clean:all": "rm -rf dist .turbo node_modules",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/kit": "^3.17.6",
    "@relativistic-ui/gravity-vue": "*"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.6.2",
    "@nuxt/eslint-config": "^1.5.2",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^3.17.6",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^9.30.1",
    "eslint-import-resolver-node": "^0.3.9",
    "nuxt": "^3.17.6",
    "typescript": "latest",
    "vitest": "*",
    "vue-tsc": "^3.0.1"
  }
}
