{
  "name": "@relativistic-ui/gravity",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:prepare": "turbo dev:prepare",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "coverage": "turbo coverage",
    "postversion": "tsx scripts/sync-versions.ts",
    "clean": "turbo clean && rm -rf node_modules",
    "clean:all": "turbo clean:all && rm -rf node_modules",
    "deploy": "turbo deploy",
    "postinstall": "turbo postinstall"
  },
  "devDependencies": {
    "prettier": "^3.4.1",
    "prettier-plugin-embed": "^0.5.0",
    "@types/node": "^24.0.13",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "latest"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "scripts",
    "apps/*",
    "packages/*",
    "shared/*"
  ]
}
